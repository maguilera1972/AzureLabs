SECRET_KEY=change-me-to-a-random-64-char-string-in-production
DEFAULT_LOCATION=francecentral
DEFAULT_VM_SIZE=Standard_D4s_v3
DEFAULT_TIMEZONE=Europe/Paris

# Application Azure AD dédiée (requis si Conditional Access / MFA)
# AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# URL publique (HTTPS via Cloudflare Tunnel — certificat géré par Cloudflare)
AZURE_PUBLIC_BASE_URL=https://azurelabs.aguilera.ch
# Redirect URI Azure AD : https://azurelabs.aguilera.ch/api/azure/auth/callback
# Origin local du tunnel cloudflared : http://localhost:80
