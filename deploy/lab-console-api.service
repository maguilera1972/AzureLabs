[Unit]
Description=Lab Console API - Azure Training Labs
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/lab-console/backend
Environment=PATH=/var/www/lab-console/venv/bin
ExecStart=/var/www/lab-console/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
